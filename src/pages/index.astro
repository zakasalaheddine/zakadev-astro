---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OfferingRow from '../components/OfferingRow.astro';
import PostRow from '../components/PostRow.astro';
import FaqItem from '../components/FaqItem.astro';
import TechTile from '../components/TechTile.astro';
import ImageSlot from '../components/ImageSlot.astro';
import NodeNetwork from '../components/NodeNetwork.astro';
import { stats, projects, offerings, posts, writingIndexHref, faqs, tech } from '../data/site';
---

<BaseLayout>
  <div id="top" class="page">
    <Nav />

    <!-- Hero -->
    <section class="hero">
      <div class="hero-copy">
        <h1 class="hero-title">
          I build systems<br />that <span class="accent">grow</span><br />businesses.
        </h1>
        <p class="hero-sub">
          AI marketing systems architect for founders who want automation that drives
          real results.
        </p>
        <div>
          <Button href="#contact" arrow fillHover>Book a strategy call</Button>
        </div>
      </div>
      <div class="hero-visual">
        <NodeNetwork />
        <div class="tag tag-automate">Automate<span class="tag-line"></span></div>
        <div class="tag tag-optimize"><span class="tag-line"></span>Optimize</div>
        <div class="tag tag-scale">Scale</div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats section-inner" aria-label="Key numbers">
      <dl class="stats-grid">
        {
          stats.map((s) => (
            <div class="stat">
              <dt class="stat-value">{s.value}</dt>
              <dd class="stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Featured projects -->
    <section id="work" class="projects section-inner">
      <div class="lead">
        <SectionLabel>Featured projects</SectionLabel>
      </div>
      <div class="projects-grid">
        {
          projects.map((p) => (
            <ProjectCard
              name={p.name}
              description={p.description}
              href={p.href}
              meta={p.meta}
              linkLabel={p.linkLabel}
            />
          ))
        }
      </div>
    </section>

    <!-- Products & communities -->
    <section id="products" class="offerings section-inner">
      <div class="lead">
        <SectionLabel>Products &amp; communities</SectionLabel>
      </div>
      <div class="offerings-list">
        {
          offerings.map((o) => (
            <OfferingRow
              name={o.name}
              description={o.description}
              href={o.href}
              badge={o.badge}
              linkLabel={o.linkLabel}
            />
          ))
        }
      </div>
    </section>

    <!-- Recent writing -->
    {
      posts.length > 0 && (
        <section id="writing" class="writing section-inner">
          <div class="lead">
            <SectionLabel>Recent writing</SectionLabel>
          </div>
          <div class="writing-list">
            {posts.map((p) => (
              <PostRow title={p.title} href={p.href} category={p.category} date={p.date} />
            ))}
          </div>
          <a href={writingIndexHref} class="text-link writing-all">
            All writing <span class="accent">&rarr;</span>
          </a>
        </section>
      )
    }

    <!-- FAQ -->
    {
      faqs.length > 0 && (
        <section id="faq" class="faq-sec section-inner">
          <div class="lead">
            <SectionLabel>FAQ</SectionLabel>
          </div>
          <div class="faq-list">
            {faqs.map((f) => (
              <FaqItem question={f.question} answer={f.answer} />
            ))}
          </div>
        </section>
      )
    }

    <!-- About -->
    <section id="about" class="about">
      <div class="about-photo">
        <ImageSlot placeholder="Drop a b&w architectural photo" />
      </div>
      <div class="about-copy">
        <SectionLabel>About me</SectionLabel>
        <h2 class="h2">Engineer by background.<br />Builder by choice.</h2>
        <p class="body-sm">
          I started as a software engineer building production applications.
        </p>
        <p class="body-sm">
          Today I combine engineering and AI to design systems that automate marketing,
          operations, and customer experiences.
        </p>
        <a href="#about" class="text-link">More about me <span class="accent">&rarr;</span></a>
      </div>
    </section>

    <!-- Tech stack -->
    <section class="tech">
      <div class="section-inner">
        <div class="lead">
          <SectionLabel color="var(--text-muted)">Tech stack</SectionLabel>
        </div>
        <div class="tech-grid">
          {tech.map((t) => <TechTile slug={t.slug} label={t.label} size={64} />)}
        </div>
      </div>
    </section>

    <!-- CTA footer -->
    <footer id="contact" class="footer">
      <div class="footer-top section-inner">
        <h2 class="footer-title">
          Ready to build your<br /><span class="accent">next system</span>?
        </h2>
        <div class="footer-cta">
          <p class="body-sm">Let's automate what's holding your business back.</p>
          <div>
            <Button href="#contact">Book a call</Button>
          </div>
        </div>
        <a href="#top" class="footer-brand" aria-label="zakadev — home">
          <img src="/assets/zakadev-white.svg" alt="" class="footer-mark" />
          <span>zakadev</span>
        </a>
      </div>
      <div class="footer-bar">
        <div class="footer-bar-inner section-inner">
          <span>&copy; 2026 zakadev. All rights reserved.</span>
          <span>Built with focus. Engineered for results.</span>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
  }

  /* Shared container. Vertical padding lives on each section. */
  .section-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding-left: var(--container-pad);
    padding-right: var(--container-pad);
  }

  .accent {
    color: var(--orange);
  }

  .h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 38px);
    line-height: 1.26;
    letter-spacing: var(--tracking-h2);
  }

  .body-sm {
    font: 400 15px/1.73 var(--font-sans);
    color: var(--text-secondary);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font: 500 14px/1 var(--font-sans);
    width: fit-content;
  }

  .text-link .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  .lead {
    margin-bottom: 32px;
  }

  /* ---------- Hero ---------- */
  .hero {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 56px var(--container-pad) 40px;
    display: flex;
    align-items: center;
    gap: 48px;
  }

  .hero-copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(40px, 6.6vw, 68px);
    line-height: 1.13;
    letter-spacing: var(--tracking-display);
  }

  .hero-sub {
    font: 400 18px/1.67 var(--font-sans);
    color: var(--text-secondary);
    max-width: 400px;
  }

  .hero-visual {
    position: relative;
    width: 560px;
    height: 420px;
    flex: none;
    max-width: 100%;
  }

  .tag {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .tag-line {
    width: 40px;
    height: 1px;
    background: var(--border-hover);
  }
  .tag-automate {
    top: 24px;
    left: 120px;
  }
  .tag-optimize {
    top: 170px;
    right: 0;
  }
  .tag-scale {
    bottom: 10px;
    left: 200px;
  }

  /* ---------- Stats ---------- */
  .stats {
    padding-top: 8px;
    padding-bottom: 96px;
  }
  .stats-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border-1);
  }
  .stat {
    padding: 32px 32px 32px 0;
    border-left: 1px solid var(--border-1);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat:first-child {
    border-left: none;
    padding-left: 0;
  }
  .stat-value {
    font: 400 clamp(34px, 4vw, 44px) / 1 var(--font-serif);
    letter-spacing: var(--tracking-h2);
    color: var(--text-primary);
  }
  .stat-label {
    margin: 0;
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- About ---------- */
  .about {
    background: var(--bg-secondary);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .about-photo {
    position: relative;
    min-height: 440px;
  }
  .about-copy {
    padding: 96px 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 640px;
  }

  /* ---------- Featured projects ---------- */
  .projects {
    padding-top: 120px;
    padding-bottom: 120px;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  /* When the last project sits alone on a row, let it span full width. */
  .projects-grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  /* ---------- Products & communities ---------- */
  .offerings {
    padding-top: 40px;
    padding-bottom: 120px;
  }
  .offerings-list {
    border-top: 1px solid var(--border-1);
  }

  /* ---------- Recent writing ---------- */
  .writing {
    padding-top: 40px;
    padding-bottom: 120px;
  }
  .writing-list {
    border-top: 1px solid var(--border-1);
  }
  .writing-all {
    margin-top: 32px;
  }

  /* ---------- FAQ ---------- */
  .faq-sec {
    padding-top: 40px;
    padding-bottom: 120px;
  }
  .faq-list {
    border-top: 1px solid var(--border-1);
  }


  /* ---------- Tech ---------- */
  .tech {
    background: var(--bg-secondary);
    padding: 96px 0;
  }
  .tech-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ---------- Footer ---------- */
  .footer-top {
    padding-top: 120px;
    padding-bottom: 96px;
    display: grid;
    grid-template-columns: 6fr 4fr 2fr;
    gap: 48px;
    align-items: center;
  }
  .footer-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 5.6vw, 52px);
    line-height: 1.19;
    letter-spacing: var(--tracking-h1);
  }
  .footer-cta {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    justify-self: end;
    color: var(--text-primary);
  }
  .footer-brand span {
    font: 500 22px/1 var(--font-sans);
    letter-spacing: -0.02em;
  }
  .footer-mark {
    height: 34px;
    width: auto;
  }
  .footer-bar {
    border-top: 1px solid var(--border-1);
  }
  .footer-bar-inner {
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font: var(--type-caption);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .footer-brand {
      justify-self: start;
    }
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column;
      align-items: flex-start;
      gap: 40px;
      padding-top: 40px;
    }
    .hero-visual {
      width: 100%;
      max-width: 520px;
      height: auto;
      aspect-ratio: 560 / 420;
      align-self: center;
    }
    .about {
      grid-template-columns: 1fr;
    }
    .about-photo {
      min-height: 300px;
    }
    .about-copy {
      padding: 56px var(--container-pad);
      max-width: none;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .projects {
      padding-top: 88px;
      padding-bottom: 88px;
    }
  }

  @media (max-width: 560px) {
    .hero-sub {
      max-width: none;
    }
    .tag {
      display: none;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Re-draw dividers for a 2-col grid: reset all, then border 3rd/4th on top. */
    .stat {
      border-left: none;
      padding-left: 0;
      padding-right: 0;
    }
    .stat:nth-child(even) {
      border-left: 1px solid var(--border-1);
      padding-left: 24px;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border-1);
    }
    .footer-top {
      padding-top: 88px;
      padding-bottom: 72px;
    }
    .footer-bar-inner {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
