---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Button from '../components/Button.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OfferingRow from '../components/OfferingRow.astro';
import PostRow from '../components/PostRow.astro';
import FaqItem from '../components/FaqItem.astro';
import TechTile from '../components/TechTile.astro';
import NodeNetwork from '../components/NodeNetwork.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import {
  stats,
  services,
  posts,
  writingIndexHref,
  faqs,
  tech,
  bookingHref,
} from '../data/site';

/* Only real case studies go in the grid — no placeholder cards. Newest first,
   capped at 3: the grid is a 2+1 layout and a fourth card breaks it. */
const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year)
  .map((entry) => ({
    name: entry.data.title,
    description: entry.data.subtitle,
    href: `/projects/${entry.id}`,
    meta: entry.data.meta,
    bucket: entry.data.bucket,
    stack: entry.data.stack,
    linkLabel: 'Read case study',
  }))
  .slice(0, 3);
---

<BaseLayout>
  <div id="top" class="page">
    <Nav />

    <!-- Hero -->
    <section class="hero">
      <div class="hero-copy">
        <h1 class="hero-title">
          I build AI systems that make businesses <span class="accent">money</span>.
        </h1>
        <p class="hero-sub">
          More customers. More revenue from each one. Fewer hours lost to manual work.
        </p>
        <div>
          <Button href={bookingHref} arrow fillHover>Book a call</Button>
        </div>
      </div>
      <div class="hero-visual">
        <NodeNetwork />
        <div class="tag tag-acquire">Acquire<span class="tag-line"></span></div>
        <div class="tag tag-retain"><span class="tag-line"></span>Retain</div>
        <div class="tag tag-automate">Automate</div>
      </div>
    </section>

    <!-- Stats -->
    <section class="stats section-inner" aria-label="Key numbers">
      <dl class="stats-grid">
        {
          stats.map((s) => (
            <div class="stat">
              <dt class:list={['stat-value', s.words && 'stat-value--words']}>{s.value}</dt>
              <dd class="stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- Selected work -->
    <section id="work" class="projects section-inner">
      <div class="lead">
        <SectionLabel as="h2">Selected work</SectionLabel>
      </div>
      <div class="projects-grid">
        {
          projects.map((p, i) => (
            <ProjectCard
              name={p.name}
              description={p.description}
              href={p.href}
              meta={p.meta}
              bucket={p.bucket}
              stack={p.stack}
              linkLabel={p.linkLabel}
              wide={i === projects.length - 1 && projects.length % 2 === 1}
            />
          ))
        }
      </div>
    </section>

    <!-- How I help -->
    <section id="services" class="offerings section-inner">
      <div class="lead">
        <SectionLabel as="h2">How I help</SectionLabel>
      </div>
      <div class="offerings-list">
        {
          services.map((s) => (
            <OfferingRow
              name={s.name}
              description={s.description}
              href={s.href}
              linkLabel={s.linkLabel}
            />
          ))
        }
      </div>
    </section>

    <!-- Recent writing -->
    {
      posts.length > 0 && (
        <section id="writing" class="writing section-inner">
          <div class="lead">
            <SectionLabel as="h2">Recent writing</SectionLabel>
          </div>
          <div class="writing-list">
            {posts.map((p) => (
              <PostRow title={p.title} href={p.href} category={p.category} date={p.date} />
            ))}
          </div>
          <a href={writingIndexHref} class="text-link writing-all">
            All writing <span class="accent">&rarr;</span>
          </a>
        </section>
      )
    }

    <!-- FAQ -->
    {
      faqs.length > 0 && (
        <section id="faq" class="faq-sec section-inner">
          <div class="lead">
            <SectionLabel as="h2">FAQ</SectionLabel>
          </div>
          <div class="faq-list">
            {faqs.map((f) => (
              <FaqItem question={f.question} answer={f.answer} />
            ))}
          </div>
        </section>
      )
    }

    <!-- About -->
    <section id="about" class="about">
      <div class="about-inner">
        <div class="about-head">
          <SectionLabel>About me</SectionLabel>
          <h2 class="h2">Engineer by background.<br />Builder by choice.</h2>
        </div>
        <div class="about-copy">
          <p class="body-sm">
            Twelve years as a software engineer, shipping production applications where
            uptime, security and maintenance actually mattered. Now I point that at AI.
          </p>
          <p class="body-sm">
            It shows in what I build: systems that know when they're unsure, recover
            when an API fails, and can be audited when someone asks why they did
            something.
          </p>
          <p class="body-sm">Based in Morocco. Clients across Europe and the US.</p>
        </div>
      </div>
    </section>

    <!-- Tech stack -->
    <section class="tech">
      <div class="section-inner">
        <div class="lead">
          <SectionLabel as="h2" color="var(--text-muted)">Tech stack</SectionLabel>
        </div>
        <div class="tech-grid">
          {tech.map((t) => <TechTile slug={t.slug} label={t.label} size={64} />)}
        </div>
      </div>
    </section>

    <Footer />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
  }

  .h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(30px, 4.4vw, 38px);
    line-height: 1.26;
    letter-spacing: var(--tracking-h2);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    font: 500 14px/1 var(--font-sans);
    width: fit-content;
  }

  .text-link .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  .lead {
    margin-bottom: 32px;
  }

  /* ---------- Hero ---------- */
  /* The claim is the hero, so the copy column takes the larger share. The
     visual shrinks first as the viewport narrows; the headline never does. */
  /* Fixed proportions, not flex-basis negotiation: the copy column has to stay
     wide enough for "that make businesses" to hold one line. */
  .hero {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 56px var(--container-pad) 48px;
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    align-items: center;
    gap: 56px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  /* No hard line breaks: the measure sets the rag, so the headline holds its
     shape at every width instead of snapping at the ones we guessed. */
  .hero-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(38px, 4.6vw, 62px);
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    max-width: 22ch;
    /* Evens the rag so the line does not end on "that". */
    text-wrap: balance;
  }

  .hero-sub {
    font: 400 20px/1.6 var(--font-sans);
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .hero-visual {
    position: relative;
    aspect-ratio: 4 / 3;
    min-width: 0;
  }

  .tag {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .tag-line {
    width: 40px;
    height: 1px;
    background: var(--border-hover);
  }
  /* Percentages, not pixels: the visual is fluid now, so the labels have to
     ride it rather than sit at coordinates that were true at 560px. */
  .tag-acquire {
    top: 6%;
    left: 21%;
  }
  .tag-retain {
    top: 40%;
    right: 0;
  }
  .tag-automate {
    bottom: 3%;
    left: 36%;
  }

  /* ---------- Stats ---------- */
  .stats {
    padding-top: 8px;
    padding-bottom: 56px;
  }
  .stats-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border-1);
  }
  .stat {
    padding: 32px 32px 32px 0;
    border-left: 1px solid var(--border-1);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat:first-child {
    border-left: none;
    padding-left: 0;
  }
  /* Values sit on a shared baseline band, so a smaller word-value still leaves
     every label on the same line across the row. */
  .stat-value {
    font: 400 clamp(34px, 4vw, 44px) / 1.05 var(--font-serif);
    letter-spacing: var(--tracking-h2);
    color: var(--text-primary);
    display: flex;
    align-items: flex-end;
    min-height: calc(clamp(34px, 4vw, 44px) * 1.05);
  }

  /* A word-value at number size wraps and drags the row out of alignment. */
  .stat-value--words {
    font-size: clamp(22px, 2.2vw, 26px);
  }
  .stat-label {
    margin: 0;
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ---------- About ---------- */
  .about {
    background: var(--bg-secondary);
  }
  /* Heading holds the left, prose answers on the right. The photo slot is gone,
     so the asymmetry has to come from the type instead. */
  .about-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 104px var(--container-pad);
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 64px;
    align-items: start;
  }
  .about-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .about-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 62ch;
    /* Optically aligns the first line with the heading's cap height. */
    padding-top: 6px;
  }

  /* ---------- Selected work ---------- */
  .projects {
    padding-top: 88px;
    padding-bottom: 104px;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  /* ---------- How I help ---------- */
  .offerings {
    padding-top: 24px;
    padding-bottom: 104px;
  }
  .offerings-list {
    border-top: 1px solid var(--border-1);
  }

  /* ---------- Recent writing ---------- */
  .writing {
    padding-top: 40px;
    padding-bottom: 120px;
  }
  .writing-list {
    border-top: 1px solid var(--border-1);
  }
  .writing-all {
    margin-top: 32px;
  }

  /* ---------- FAQ ---------- */
  .faq-sec {
    padding-top: 24px;
    padding-bottom: 112px;
  }
  .faq-list {
    border-top: 1px solid var(--border-1);
  }


  /* ---------- Tech ---------- */
  .tech {
    background: var(--bg-secondary);
    padding: 96px 0;
  }
  .tech-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 40px;
      padding-top: 40px;
    }
    .hero-visual {
      width: 100%;
      max-width: 520px;
      justify-self: center;
    }
    .about-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 64px var(--container-pad);
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
    .projects {
      padding-top: 72px;
      padding-bottom: 72px;
    }
  }

  @media (max-width: 560px) {
    .hero-sub {
      max-width: none;
    }
    /* The labels are what make the constellation mean anything, and they do not
       fit here. Without them it is 250px of noise above the fold, so it goes. */
    .hero-visual {
      display: none;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Half the column width here, so the word-value drops another step rather
       than wrapping and pushing its label off the row's line. */
    .stat-value--words {
      font-size: 18px;
    }
    /* Re-draw dividers for a 2-col grid: reset all, then border 3rd/4th on top. */
    .stat {
      border-left: none;
      padding-left: 0;
      padding-right: 0;
    }
    .stat:nth-child(even) {
      border-left: 1px solid var(--border-1);
      padding-left: 24px;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border-1);
    }
  }
</style>
