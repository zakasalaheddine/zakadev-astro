---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, subtitle, role, stack, year } = entry.data;
---

<BaseLayout title={`${title} · zakadev`} description={subtitle}>
  <div id="top" class="page">
    <Nav />

    <article class="case">
      <header class="case-head">
        <a class="back" href="/#work"><span aria-hidden="true">&larr;</span> All projects</a>
        <h1 class="case-title">{title}</h1>
        <p class="case-sub">{subtitle}</p>
        <dl class="case-meta">
          <div><dt>Role</dt><dd>{role}</dd></div>
          <div><dt>Stack</dt><dd>{stack}</dd></div>
          <div><dt>Year</dt><dd>{year}</dd></div>
        </dl>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-pad);
  }

  .case {
    max-width: 72ch;
    margin: 0 auto;
    padding: var(--space-11) 0 var(--space-13);
  }

  .back {
    display: inline-block;
    font: var(--type-small);
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }
  .back:hover {
    color: var(--text-primary);
  }

  .case-title {
    font: var(--type-h1);
    letter-spacing: var(--tracking-h1);
    color: var(--text-primary);
    margin: 0 0 var(--space-4);
  }

  .case-sub {
    font: var(--type-body-lg);
    color: var(--text-secondary);
    margin: 0 0 var(--space-8);
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: 0;
    padding: var(--space-5) 0;
    border-top: 1px solid var(--border-1);
    border-bottom: 1px solid var(--border-1);
  }
  .case-meta dt {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: var(--space-2);
  }
  .case-meta dd {
    font: var(--type-small);
    color: var(--text-primary);
    margin: 0;
  }

  /* The markdown body arrives through <slot>, so these rules have to be global —
     scoped styles never reach content Astro didn't author in this file. */
  .prose :global(h2) {
    font: var(--type-h3);
    color: var(--text-primary);
    margin: var(--space-11) 0 var(--space-4);
  }
  .prose :global(h3) {
    font: var(--type-h4);
    color: var(--text-primary);
    margin: var(--space-8) 0 var(--space-3);
  }
  .prose :global(p),
  .prose :global(li) {
    font: var(--type-body);
    color: var(--text-secondary);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }
  .prose :global(li) {
    margin-bottom: var(--space-3);
  }
  .prose :global(li)::marker {
    color: var(--orange);
  }
  .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }
  .prose :global(em) {
    color: var(--text-secondary);
  }
  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--border-1);
    margin: var(--space-11) 0;
  }
  .prose :global(code) {
    font-size: 0.9em;
    background: var(--bg-card);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-2);
    padding: 2px 6px;
  }

  @media (max-width: 900px) {
    .case {
      padding: var(--space-9) 0 var(--space-11);
    }
    .case-title {
      font: var(--type-h2);
      letter-spacing: var(--tracking-h2);
    }
    .case-meta {
      gap: var(--space-5);
    }
  }
</style>
