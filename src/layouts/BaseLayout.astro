---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zakadev · AI systems that make businesses money',
  description = 'I build AI systems that bring in more customers, raise what each one is worth, and cut the hours your team loses to manual work. Twelve years of production engineering behind every build.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/zakadev-white.svg" type="image/svg+xml" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
