---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'zakadev — AI marketing systems architect',
  description = 'AI marketing systems architect for founders who want automation that drives real results.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/assets/zakadev-white.svg" type="image/svg+xml" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
