---
const links = [
  { label: 'Work', href: '#work' },
  { label: 'Services', href: '#services' },
  { label: 'Process', href: '#process' },
  { label: 'About', href: '#about' },
  { label: 'Contact', href: '#contact' },
];
---

<header class="nav">
  <div class="cluster">
    <!-- Logo pill -->
    <a class="logo-pill" href="#top" aria-label="zakadev — home">
      <img src="/assets/zakadev-white.svg" alt="" class="logo-mark" />
      <span class="logo-name">zakadev</span>
    </a>

    <!-- CSS-only mobile toggle -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="burger" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </label>

    <!-- Links pill -->
    <nav class="links-pill">
      {links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
      <span class="divider" aria-hidden="true"></span>
      <a class="book" href="#contact">
        Book a Call
        <span class="book-dot" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 20px var(--container-pad) 0;
  }

  .cluster {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Shared pill surface */
  .logo-pill,
  .links-pill {
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: 999px;
    height: 52px;
    display: flex;
    align-items: center;
    transition: border-color var(--duration-base) var(--ease-brand);
  }
  .logo-pill:hover,
  .links-pill:hover {
    border-color: var(--border-2);
  }

  .logo-pill {
    gap: 10px;
    padding: 0 20px 0 16px;
    color: var(--text-primary);
    flex: none;
  }
  .logo-mark {
    height: 24px;
    width: auto;
  }
  .logo-name {
    font: 500 18px/1 var(--font-sans);
    letter-spacing: -0.02em;
  }

  .links-pill {
    gap: 28px;
    padding: 0 12px 0 28px;
  }
  .link {
    font: var(--type-small);
    color: var(--text-secondary);
  }
  .link:hover {
    color: var(--text-primary);
  }

  .divider {
    width: 1px;
    height: 20px;
    background: var(--border-2);
    flex: none;
  }

  .book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--surface-3);
    border: 1px solid var(--border-2);
    color: var(--text-primary);
    font: 500 14px/1 var(--font-sans);
    white-space: nowrap;
    transition: all var(--duration-base) var(--ease-brand);
  }
  .book:hover {
    border-color: rgba(252, 163, 17, 0.6);
    box-shadow: var(--glow-accent);
    color: var(--text-primary);
  }
  .book-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  /* Mobile machinery — hidden on desktop */
  .nav-toggle,
  .burger {
    display: none;
  }

  @media (max-width: 860px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 52px;
      height: 52px;
      padding: 15px;
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      border-radius: 999px;
      cursor: pointer;
      flex: none;
    }
    .burger span {
      height: 2px;
      width: 100%;
      background: var(--text-primary);
      border-radius: 2px;
      transition: transform var(--duration-base) var(--ease-brand),
        opacity var(--duration-base) var(--ease-brand);
    }
    .nav-toggle:checked ~ .burger span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle:checked ~ .burger span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .burger span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .links-pill {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      width: min(320px, calc(100vw - 44px));
      height: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px 20px;
      border-radius: var(--radius-5);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      pointer-events: none;
      transition: max-height var(--duration-slow) var(--ease-brand),
        opacity var(--duration-base) var(--ease-brand);
      z-index: 20;
    }
    .nav-toggle:checked ~ .links-pill {
      max-height: 400px;
      opacity: 1;
      pointer-events: auto;
    }
    .link {
      padding: 12px 0;
      font-size: 16px;
    }
    .divider {
      width: 100%;
      height: 1px;
      margin: 6px 0;
    }
    .book {
      height: 44px;
      justify-content: center;
      margin-top: 4px;
    }
  }
</style>
