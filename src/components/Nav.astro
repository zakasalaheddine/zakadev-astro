---
const links = [
  { label: 'Work', href: '/#work' },
  /* No "Writing" link — the section is hidden until real posts exist. */
  { label: 'How I help', href: '/#services' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'About', href: '/#about' },
];
---

<header class="nav">
  <div class="cluster">
    <!-- Logo pill -->
    <a class="logo-pill" href="/#top" aria-label="zakadev — home">
      <img src="/assets/zakadev-white.svg" alt="" class="logo-mark" />
      <span class="logo-name">zakadev</span>
    </a>

    <!-- Mobile toggle. A real button so it is reachable and operable by keyboard. -->
    <button
      type="button"
      class="burger"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <span></span><span></span><span></span>
    </button>

    <!-- Links pill -->
    <nav class="links-pill" id="nav-menu">
      {links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
      <span class="divider" aria-hidden="true"></span>
      <a class="book" href="/#contact">
        Book a Call
        <span class="book-dot" aria-hidden="true"></span>
      </a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 20px var(--container-pad) 0;
  }

  .cluster {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Shared pill surface */
  .logo-pill,
  .links-pill {
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: 999px;
    height: 52px;
    display: flex;
    align-items: center;
    transition: border-color var(--duration-base) var(--ease-brand);
  }
  .logo-pill:hover,
  .links-pill:hover {
    border-color: var(--border-2);
  }

  .logo-pill {
    gap: 10px;
    padding: 0 20px 0 16px;
    color: var(--text-primary);
    flex: none;
  }
  .logo-mark {
    height: 24px;
    width: auto;
  }
  .logo-name {
    font: 500 18px/1 var(--font-sans);
    letter-spacing: -0.02em;
  }

  .links-pill {
    gap: 28px;
    padding: 0 12px 0 28px;
  }
  .link {
    font: var(--type-small);
    color: var(--text-secondary);
  }
  .link:hover {
    color: var(--text-primary);
  }

  .divider {
    width: 1px;
    height: 20px;
    background: var(--border-2);
    flex: none;
  }

  .book {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--surface-3);
    border: 1px solid var(--border-2);
    color: var(--text-primary);
    font: 500 14px/1 var(--font-sans);
    white-space: nowrap;
    transition: all var(--duration-base) var(--ease-brand);
  }
  .book:hover {
    border-color: var(--orange-a60);
    box-shadow: var(--glow-accent);
    color: var(--text-primary);
  }
  .book-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  /* Mobile machinery — hidden on desktop */
  .burger {
    display: none;
  }

  @media (max-width: 860px) {
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 52px;
      height: 52px;
      padding: 15px;
      background: var(--surface-2);
      border: 1px solid var(--border-1);
      border-radius: 999px;
      cursor: pointer;
      flex: none;
    }
    .burger span {
      height: 2px;
      width: 100%;
      background: var(--text-primary);
      border-radius: 2px;
      transition: transform var(--duration-base) var(--ease-brand),
        opacity var(--duration-base) var(--ease-brand);
    }
    .burger[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .burger[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }
    .burger[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .links-pill {
      position: absolute;
      top: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      width: min(320px, calc(100vw - 44px));
      height: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 10px 20px;
      border-radius: var(--radius-5);
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      /* visibility (not just opacity) so closed links leave the tab order. */
      visibility: hidden;
      transition: max-height var(--duration-slow) var(--ease-brand),
        opacity var(--duration-base) var(--ease-brand),
        visibility 0s linear var(--duration-slow);
      z-index: 20;
    }
    .nav.is-open .links-pill {
      max-height: 400px;
      opacity: 1;
      visibility: visible;
      transition: max-height var(--duration-slow) var(--ease-brand),
        opacity var(--duration-base) var(--ease-brand),
        visibility 0s;
    }
    .link {
      padding: 12px 0;
      font-size: 16px;
    }
    .divider {
      width: 100%;
      height: 1px;
      margin: 6px 0;
    }
    .book {
      height: 44px;
      justify-content: center;
      margin-top: 4px;
    }
  }
</style>

<script>
  const nav = document.querySelector('.nav');
  const burger = nav?.querySelector('.burger') as HTMLButtonElement | null;
  const menu = nav?.querySelector('.links-pill');

  if (nav && burger && menu) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    // Jumping to a section should dismiss the menu covering it.
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    // Leaving mobile width hides the burger; drop the open state with it.
    window.matchMedia('(max-width: 860px)').addEventListener('change', (e) => {
      if (!e.matches) setOpen(false);
    });
  }
</script>
