---
/**
 * Hero particle spiral. Ported 1:1 from the design's canvas logic to vanilla JS.
 * Honors prefers-reduced-motion by drawing a single static frame.
 */
---

<canvas class="spiral" width="560" height="420" aria-hidden="true"></canvas>

<style>
  .spiral {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  const canvas = document.currentScript
    ? (document.currentScript.previousElementSibling as HTMLCanvasElement | null)
    : null;

  // In Astro's bundled script, currentScript is null — select directly.
  const c =
    canvas ?? (document.querySelector('canvas.spiral') as HTMLCanvasElement | null);

  if (c) {
    const ctx = c.getContext('2d');
    const W = (c.width = 560);
    const H = (c.height = 420);

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const animate = !reduce;

    const pts = [];
    for (let i = 0; i < 900; i++) {
      const t = i / 900;
      const a = t * Math.PI * 7;
      const r = 30 + t * 190;
      pts.push({
        a,
        r: r + (Math.random() - 0.5) * 26,
        y: (Math.random() - 0.5) * 30,
        s: Math.random(),
        sp: 0.0015 + Math.random() * 0.002,
      });
    }

    const draw = (time: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, W, H);
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        if (animate) p.a += p.sp;
        const x = W / 2 + Math.cos(p.a) * p.r;
        const y = H / 2 + Math.sin(p.a) * p.r * 0.42 + p.y;
        const orange = i % 137 === 0;
        ctx.fillStyle = orange
          ? 'rgba(252,163,17,' + (0.5 + 0.4 * Math.sin(time / 700 + i)) + ')'
          : 'rgba(255,255,255,' + (0.08 + p.s * 0.35) + ')';
        const sz = orange ? 2.2 : 0.7 + p.s * 0.9;
        ctx.beginPath();
        ctx.arc(x, y, sz, 0, 7);
        ctx.fill();
      }
      if (animate) requestAnimationFrame(draw);
    };

    requestAnimationFrame(draw);
  }
</script>
