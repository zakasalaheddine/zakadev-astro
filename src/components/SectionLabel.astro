---
/**
 * Uppercase orange caption that opens every section ("WHAT I BUILD", "MY PROCESS").
 *
 * Pass `as="h2"` where the caption is the section's actual title, so the caption
 * carries the heading semantics it already carries visually. Sections that own a
 * separate headline (About) leave it a plain div — that headline is the h2.
 */
interface Props {
  as?: 'div' | 'h2' | 'h3';
  color?: string;
  class?: string;
}

const { as: Tag = 'div', color = 'var(--orange)', class: className } = Astro.props;
---

<Tag class:list={['section-label', className]} style={`color:${color}`}>
  <slot />
</Tag>

<style>
  .section-label {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
  }
</style>
