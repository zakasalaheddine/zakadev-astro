---
/**
 * zakadev button. Primary = white label + orange dot; secondary = plain outline.
 * Never orange-filled at rest (per the design system).
 *
 * Opt-in props:
 *  - arrow: render a trailing orange arrow (instead of the dot) that nudges right on hover.
 *  - fillHover: on hover, fill orange with dark text (used for the hero CTA).
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  arrow?: boolean;
  fillHover?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = false, fillHover = false, class: className } =
  Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['btn', fillHover && 'btn--fill', className]} href={href}>
  <slot />
  {
    arrow ? (
      <span class="arrow" aria-hidden="true">&rarr;</span>
    ) : (
      variant === 'primary' && <span class="dot" aria-hidden="true" />
    )
  }
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--surface-1);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-2);
    color: var(--text-primary);
    font: 500 15px/1 var(--font-sans);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--duration-base) var(--ease-brand);
  }

  .btn:hover {
    background: var(--surface-2);
    border-color: rgba(252, 163, 17, 0.6);
    box-shadow: var(--glow-accent);
    transform: translateY(-1px);
    color: var(--text-primary);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange);
    flex: none;
  }

  .arrow {
    display: inline-block;
    color: var(--orange);
    font-size: 16px;
    line-height: 1;
    transition: transform var(--duration-base) var(--ease-brand),
      color var(--duration-base) var(--ease-brand);
  }

  .btn:hover .arrow {
    transform: translateX(3px);
  }

  /* Fill-on-hover variant — solid orange, dark label. */
  .btn--fill:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: #050505;
    box-shadow: none;
  }

  .btn--fill:hover .arrow {
    color: #050505;
  }
</style>
