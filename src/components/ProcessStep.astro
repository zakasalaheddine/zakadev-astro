---
/** Numbered process step: oversized serif ordinal + orange trailing line, title, small body. */
interface Props {
  number: string;
  title: string;
  description: string;
  showLine?: boolean;
}

const { number, title, description, showLine = true } = Astro.props;
---

<div class="step">
  <div class="row">
    <span class="num">{number}</span>
    {
      showLine && (
        <span class="line">
          <span class="line-dot" aria-hidden="true" />
        </span>
      )
    }
  </div>
  <div class="title">{title}</div>
  <div class="desc">{description}</div>
</div>

<style>
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .num {
    font: 400 44px/1 var(--font-serif);
    color: var(--text-muted);
  }

  .line {
    position: relative;
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-2), rgba(252, 163, 17, 0.6));
  }

  .line-dot {
    position: absolute;
    right: 0;
    top: -2.5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }

  .title {
    font: 500 17px/1.3 var(--font-sans);
    color: var(--text-primary);
  }

  .desc {
    font: var(--type-small);
    color: var(--text-muted);
  }
</style>
