---
/**
 * Site footer: the CTA block, a large-type restatement of the page's
 * destinations, and the brand as one full-bleed word.
 *
 * Used on every page, so the section links are root-relative: from a case
 * study, "#work" would look for a section that is not there.
 */
import Button from './Button.astro';
import { getCollection } from 'astro:content';
import { socials, bookingHref } from '../data/site';

const nav = [
  { label: 'Work', href: '/#work' },
  { label: 'How I help', href: '/#services' },
  { label: 'FAQ', href: '/#faq' },
  { label: 'About', href: '/#about' },
];

const caseStudies = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year)
  .map((entry) => ({ title: entry.data.title, href: `/projects/${entry.id}` }));
---

<footer id="contact" class="footer">
  <div class="footer-top section-inner">
    <h2 class="footer-title">
      Ready to build your<br /><span class="accent">next system</span>?
    </h2>
    <div class="footer-cta">
      <p class="body-sm">
        Bring the workflow that's eating your team's time. Thirty minutes is enough to
        know if it's worth automating.
      </p>
      <div>
        <Button href={bookingHref}>Book a call</Button>
      </div>
    </div>
  </div>

  <div class="footer-map section-inner">
    <nav class="foot-nav" aria-label="Footer">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="foot-cols">
      <div class="foot-col">
        <h3 class="foot-col-title">Case studies</h3>
        {caseStudies.map((p) => <a href={p.href}>{p.title}</a>)}
      </div>
      <div class="foot-col">
        <h3 class="foot-col-title">Elsewhere</h3>
        {/* Off-site profiles open in a tab of their own, so checking the Upwork
            reviews does not cost you the page. */}
        {socials.map((s) => (
          <a
            href={s.href}
            target={s.href.startsWith('http') ? '_blank' : undefined}
            rel={s.href.startsWith('http') ? 'noopener' : undefined}
          >
            {s.label}
          </a>
        ))}
      </div>
      <p class="foot-blurb">
        AI systems that make businesses money. Based in Morocco, working with clients
        across Europe and the US.
      </p>
    </div>
  </div>

  <!-- Decorative: the brand is already named in the nav and the copyright. -->
  <div class="wordmark" aria-hidden="true">zakadev</div>

  <div class="footer-bar">
    <div class="footer-bar-inner section-inner">
      <span>&copy; 2026 zakadev. All rights reserved.</span>
      <span>Built with Astro. No trackers, no cookie banner.</span>
    </div>
  </div>
</footer>

<style>
  /* Sizing context for the full-bleed wordmark below. */
  .footer {
    container-type: inline-size;
  }

  .footer-top {
    padding-top: 120px;
    padding-bottom: 88px;
    display: grid;
    grid-template-columns: 6fr 5fr;
    gap: 48px;
    align-items: center;
  }
  .footer-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(36px, 5.6vw, 52px);
    line-height: 1.19;
    letter-spacing: var(--tracking-h1);
    margin: 0;
  }
  .footer-cta {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .footer-map {
    padding-bottom: 72px;
    border-top: 1px solid var(--border-1);
    padding-top: 48px;
  }

  /* The page's four destinations, restated at display size and spread edge to
     edge. This is the row that makes the footer read as a place, not a margin. */
  .foot-nav {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px 40px;
    margin-bottom: 64px;
  }
  .foot-nav a {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(26px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: var(--tracking-h2);
    color: var(--text-primary);
  }
  .foot-nav a:hover {
    color: var(--orange);
  }

  .foot-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 1.4fr);
    gap: 40px;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .foot-col-title {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 6px;
  }
  .foot-col a {
    font: var(--type-small);
    color: var(--text-secondary);
  }
  .foot-col a:hover {
    color: var(--text-primary);
  }
  .foot-blurb {
    font: var(--type-small);
    color: var(--text-muted);
    max-width: 42ch;
    justify-self: end;
    margin: 0;
  }

  /* Full-bleed brand line. Measured, not guessed: the word renders 3.75x its
     font size at this tracking, so width / 3.75 fills the container exactly.
     Container units, not vw, so a desktop scrollbar cannot clip the last letter. */
  .wordmark {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: min(calc((100cqw - 2 * var(--container-pad)) / 3.75), 341px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    text-align: center;
    color: var(--text-primary);
    padding: 0 var(--container-pad);
    overflow: hidden;
    user-select: none;
  }

  .footer-bar {
    border-top: 1px solid var(--border-1);
  }
  .footer-bar-inner {
    padding-top: 24px;
    padding-bottom: 24px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font: var(--type-caption);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .foot-blurb {
      grid-column: 1 / -1;
      justify-self: start;
      max-width: none;
    }
  }

  @media (max-width: 560px) {
    /* Spread across a wrapped row leaves one orphan pushed to an edge, so the
       links close up into a left-aligned cluster instead. */
    .foot-nav {
      justify-content: flex-start;
      gap: 16px 28px;
      margin-bottom: 48px;
    }
    .footer-top {
      padding-top: 88px;
      padding-bottom: 72px;
    }
    .footer-bar-inner {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
