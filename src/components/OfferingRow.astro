---
/** A product/community row: name + badge (price or "Free"), description, CTA link. */
interface Props {
  name: string;
  description: string;
  href?: string;
  badge?: string;
  linkLabel?: string;
}

const { name, description, href = '#', badge, linkLabel = 'Learn more' } = Astro.props;
---

<a class="row" href={href}>
  <div class="row-main">
    <div class="row-head">
      <span class="row-name">{name}</span>
      {badge && <span class="row-badge">{badge}</span>}
    </div>
    <p class="row-desc">{description}</p>
  </div>
  <span class="row-cta">
    {linkLabel}
    <span class="row-arrow" aria-hidden="true">&rarr;</span>
  </span>
</a>

<style>
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 28px 4px;
    border-bottom: 1px solid var(--border-1);
    color: inherit;
    text-decoration: none;
  }

  /* Nudge the content, not the box: transform stays off the layout path. */
  .row-main,
  .row-cta {
    transition: transform var(--duration-base) var(--ease-brand);
  }
  .row:hover .row-main {
    transform: translateX(8px);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .row-head {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .row-name {
    font: var(--type-h4);
    color: var(--text-primary);
  }

  .row-badge {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--orange);
    border: 1px solid var(--orange-a35);
    border-radius: 999px;
    padding: 4px 11px;
  }

  .row-desc {
    font: var(--type-small);
    color: var(--text-secondary);
    margin: 0;
  }

  .row-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: none;
    font: 500 14px/1 var(--font-sans);
    color: var(--text-primary);
  }

  .row-arrow {
    display: inline-block;
    color: var(--orange);
    transition: transform var(--duration-base) var(--ease-brand);
  }
  .row:hover .row-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    /* No hover on touch; keep the row still. */
    .row:hover .row-main {
      transform: none;
    }
  }
</style>
