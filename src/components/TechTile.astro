---
import { techIcons } from '../data/techIcons';

/** Bordered dark tile for a brand icon, with a styled tooltip on hover. */
interface Props {
  /** Icon key in techIcons; when omitted, the label text is shown instead. */
  slug?: string;
  label: string;
  size?: number;
}

const { slug, label, size = 64 } = Astro.props;
const icon = slug ? techIcons[slug] : undefined;
---

<!-- Text tiles size to their label; a fixed square clips anything past ~8 chars. -->
<div
  class:list={['tile', !icon && 'tile--text']}
  style={`${icon ? 'width' : 'min-width'}:${size}px;height:${size}px`}
  role="img"
  aria-label={label}
>
  {
    icon ? (
      <svg class="tile-icon" viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
        <path d={icon.path} />
      </svg>
    ) : (
      <span class="tile-label">{label}</span>
    )
  }
  <span class="tile-tip" aria-hidden="true">{label}</span>
</div>

<style>
  .tile {
    position: relative;
    flex: none;
    background: var(--surface-2);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font: 500 11px/1 monospace;
    transition: border-color var(--duration-base) var(--ease-brand),
      color var(--duration-base) var(--ease-brand);
  }

  .tile:hover {
    border-color: var(--border-hover);
    color: var(--text-primary);
  }

  .tile--text {
    padding: 0 14px;
  }

  .tile-label {
    opacity: 0.7;
    white-space: nowrap;
  }
  .tile:hover .tile-label {
    opacity: 1;
  }

  .tile-icon {
    display: block;
    opacity: 0.72;
    transition: opacity var(--duration-base) var(--ease-brand);
  }
  .tile:hover .tile-icon {
    opacity: 1;
  }

  /* Styled tooltip */
  .tile-tip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    padding: 6px 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-2);
    border-radius: var(--radius-2);
    box-shadow: var(--shadow-sm);
    color: var(--text-primary);
    font: 500 12px/1 var(--font-sans);
    letter-spacing: 0.01em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition: opacity var(--duration-base) var(--ease-brand),
      transform var(--duration-base) var(--ease-brand);
    z-index: 10;
  }

  /* Little caret under the tooltip */
  .tile-tip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--border-2);
  }

  .tile:hover .tile-tip,
  .tile:focus-within .tile-tip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-tip {
      transition: opacity var(--duration-base) var(--ease-brand);
      transform: translate(-50%, 0);
    }
  }
</style>
