---
/**
 * Featured-project card: optional tag, title, description, arrow link.
 *
 * `wide` is for the odd card left alone on the final row. It spans both columns
 * and turns horizontal — a stretched vertical card is mostly empty space, so the
 * extra width has to buy a different composition rather than a longer one.
 */
interface Props {
  name: string;
  description: string;
  href?: string;
  meta?: string;
  /** Outcome bucket, shown as a muted second tag. */
  bucket?: string;
  linkLabel?: string;
  wide?: boolean;
}

const {
  name,
  description,
  href = '#',
  meta,
  bucket,
  linkLabel = 'View project',
  wide = false,
} = Astro.props;
---

<a class:list={['pcard', wide && 'pcard--wide']} href={href}>
  <div class="pcard-head">
    <div class="pcard-tags">
      {meta && <span class="pcard-tag">{meta}</span>}
      {bucket && <span class="pcard-tag pcard-tag--bucket">{bucket}</span>}
    </div>
    <h3 class="pcard-title">{name}</h3>
  </div>
  <div class="pcard-body">
    <p class="pcard-desc">{description}</p>
    <span class="pcard-link">
      {linkLabel}
      <span class="pcard-arrow" aria-hidden="true">&rarr;</span>
    </span>
  </div>
</a>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-1);
    border-radius: var(--radius-4);
    padding: 32px;
    color: inherit;
    text-decoration: none;
    transition: border-color var(--duration-base) var(--ease-brand),
      transform var(--duration-base) var(--ease-brand),
      box-shadow var(--duration-base) var(--ease-brand);
  }

  .pcard:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    color: inherit;
  }

  .pcard-head,
  .pcard-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    min-width: 0;
  }
  .pcard-body {
    flex: 1;
  }

  .pcard-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pcard-tag {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--orange);
    border: 1px solid var(--border-2);
    border-radius: 999px;
    padding: 4px 11px;
  }

  /* Secondary to the type tag: same shape, no accent colour. */
  .pcard-tag--bucket {
    color: var(--text-muted);
  }

  .pcard-title {
    font: var(--type-h4);
    color: var(--text-primary);
  }

  /* The description takes the slack so the link is pinned to the card's bottom.
     Grid rows are equal height, so links stay aligned across a row even when the
     descriptions run to different lengths. */
  .pcard-desc {
    font: var(--type-small);
    color: var(--text-secondary);
    flex: 1;
  }

  .pcard-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 14px/1 var(--font-sans);
    color: var(--text-primary);
  }

  .pcard-arrow {
    display: inline-block;
    color: var(--orange);
    transition: transform var(--duration-base) var(--ease-brand);
  }

  .pcard:hover .pcard-arrow {
    transform: translateX(3px);
  }

  /* The full-row card: title holds the left, supporting copy answers on the
     right, so the width reads as deliberate instead of leftover. */
  .pcard--wide {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: center;
    gap: 64px;
    padding: 40px 32px;
  }
  .pcard--wide .pcard-head,
  .pcard--wide .pcard-body {
    flex: 1;
  }
  .pcard--wide .pcard-title {
    font: var(--type-h3);
  }
  /* Vertically centred, so there is no slack to take. */
  .pcard--wide .pcard-desc {
    max-width: 46ch;
    flex: none;
  }

  @media (max-width: 900px) {
    .pcard--wide {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding: 32px;
    }
    .pcard--wide .pcard-head,
    .pcard--wide .pcard-body {
      align-items: flex-start;
    }
    .pcard--wide .pcard-title {
      font: var(--type-h4);
    }
  }
</style>
