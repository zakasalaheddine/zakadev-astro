---
/**
 * Intentional empty image slot. Mirrors the design's "drop a photo here" slots —
 * a styled placeholder, not a broken image. Pass `src`/`alt` to fill it later.
 */
interface Props {
  placeholder?: string;
  src?: string;
  alt?: string;
  class?: string;
}

const { placeholder = '', src, alt = '', class: className } = Astro.props;
---

{
  src ? (
    <img class:list={['slot-img', className]} src={src} alt={alt} />
  ) : (
    <div class:list={['slot', className]} role="img" aria-label={placeholder}>
      <svg
        class="slot-icon"
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="9" cy="9" r="1.6" />
        <path d="m21 15-5-5L5 21" />
      </svg>
      <span class="slot-text">{placeholder}</span>
    </div>
  )
}

<style>
  .slot,
  .slot-img {
    width: 100%;
    height: 100%;
  }

  .slot-img {
    object-fit: cover;
    display: block;
  }

  .slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
    background:
      radial-gradient(120% 120% at 50% 0%, var(--surface-1), var(--bg-secondary));
    border: 1px dashed var(--border-2);
    color: var(--text-muted);
  }

  .slot-icon {
    opacity: 0.65;
  }

  .slot-text {
    font: var(--type-caption);
    letter-spacing: 0.04em;
    max-width: 220px;
  }
</style>
