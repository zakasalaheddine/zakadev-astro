---
/** CSS-only FAQ accordion item (native <details>), with a plus→minus icon. */
interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="faq">
  <summary class="faq-q">
    <span class="faq-q-text">{question}</span>
    <span class="faq-icon" aria-hidden="true"></span>
  </summary>
  <div class="faq-a">
    <p>{answer}</p>
  </div>
</details>

<style>
  .faq {
    border-bottom: 1px solid var(--border-1);
  }

  .faq-q {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 4px;
    font: 500 19px/1.4 var(--font-sans);
    color: var(--text-primary);
    transition: color var(--duration-base) var(--ease-brand);
  }
  .faq-q::-webkit-details-marker {
    display: none;
  }
  .faq-q:hover {
    color: var(--orange);
  }

  /* Plus icon that becomes a minus when open. */
  .faq-icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex: none;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--orange);
    transition: transform var(--duration-base) var(--ease-brand);
  }
  .faq-icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    transform: translateY(-50%);
  }
  .faq-icon::after {
    left: 50%;
    top: 0;
    width: 2px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq[open] .faq-icon::after {
    transform: translateX(-50%) scaleY(0);
  }

  .faq-a {
    padding: 0 4px 24px;
    max-width: 720px;
  }
  .faq-a p {
    margin: 0;
    font: var(--type-small);
    color: var(--text-secondary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq[open] .faq-a {
      animation: faq-reveal var(--duration-slow) var(--ease-brand);
    }
    @keyframes faq-reveal {
      from {
        opacity: 0;
        transform: translateY(-4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
