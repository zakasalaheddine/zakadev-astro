---
/** A single blog-index entry: category · date meta, title, hover arrow. */
interface Props {
  title: string;
  href?: string;
  category?: string;
  date?: string;
}

const { title, href = '#', category, date } = Astro.props;
const meta = [category, date].filter(Boolean).join(' · ');
---

<a class="post" href={href}>
  <div class="post-main">
    {meta && <span class="post-meta">{meta}</span>}
    <span class="post-title">{title}</span>
  </div>
  <span class="post-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .post {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 24px 4px;
    border-bottom: 1px solid var(--border-1);
    color: inherit;
    text-decoration: none;
  }

  /* Nudge the content, not the box: transform stays off the layout path. */
  .post-main {
    transition: transform var(--duration-base) var(--ease-brand);
  }
  .post:hover .post-main {
    transform: translateX(8px);
  }

  .post-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .post-meta {
    font: var(--type-caption);
    letter-spacing: var(--tracking-caption);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post-title {
    font: 500 19px/1.3 var(--font-sans);
    color: var(--text-primary);
  }

  .post-arrow {
    flex: none;
    display: inline-block;
    font-size: 18px;
    color: var(--orange);
    transition: transform var(--duration-base) var(--ease-brand);
  }
  .post:hover .post-arrow {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .post {
      gap: 20px;
    }
    /* No hover on touch; keep the row still. */
    .post:hover .post-main {
      transform: none;
    }
  }
</style>
